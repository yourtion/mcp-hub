    "@mcp-core/mcp-hub-share": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.16.0",
    "bcryptjs": "^3.0.2",
    "fetch-to-node": "^2.1.0",
    "hono": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.17",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
