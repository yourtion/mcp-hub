    "test:e2e": "vitest --run src/e2e/",
    "test:coverage": "vitest --run --coverage",
    "test:debug": "VITEST_DEBUG=true vitest --run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
